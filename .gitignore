# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.vite/

# Env / secrets — NEVER commit these (public repo)
.env
.env.*
*.local
secrets.*
*.pem
*.key

# OS / editor cruft
.DS_Store
Thumbs.db
*.log

# Claude Code local overrides (personal, not shared)
.claude/settings.local.json

# Ontology source cache (re-clonable; see scripts/build-ontology.mjs)
.ontology-src/

# The private-names list the commit hook reads. Untracked ON PURPOSE — a
# tracked list would put the names it protects back into this public repo.
.claude/private-names
