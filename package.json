{
  "name": "incrgame",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Semantic Drift \u2014 a knowledge-graph incremental game",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "icons": "node scripts/gen-icons.mjs",
    "check:core": "node scripts/check-core-purity.mjs",
    "play": "node scripts/play-delve.mjs",
    "guard": "npm run check && npm run check:core && npm run check:vocab && npx vitest run",
    "delve": "node scripts/play-delve.mjs",
    "play:town": "node scripts/play-camp.mjs",
    "check:vocab": "node scripts/check-vocab.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.1.1",
    "playwright-core": "^1.62.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "typescript": "~5.9.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "break_eternity.js": "^2.1.3",
    "d3-force": "^3.0.0"
  }
}
